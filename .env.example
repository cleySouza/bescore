# Supabase
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Strapi
VITE_STRAPI_URL=https://YOUR_STRAPI_HOST
VITE_STRAPI_API_TOKEN=YOUR_STRAPI_READONLY_TOKEN

# Opcional: botão de injetar participantes mock — só em dev, ou em prod se as duas linhas abaixo forem true (rebuild).
VITE_FEATURE_ENABLE_MOCK_SEED=false
# Só para builds `vite build`: sem isto, o botão nunca aparece em produção mesmo se a linha acima for true.
VITE_MOCK_SEED_ALLOW_PRODUCTION=false